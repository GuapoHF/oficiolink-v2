# =============================================================================
# OficioLink — Plantilla de Variables de Entorno (.env.example)
# CONTROL #1 y #3: Separación estricta de claves públicas (ANON) y privadas (SERVER)
# Copia este archivo a `.env` para desarrollo local: cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. VARIABLES PÚBLICAS DE CLIENTE (Prefijo VITE_ — Protegidas por RLS en DB)
# ¡PROHIBIDO colocar aquí la SERVICE_ROLE_KEY o secretos de servidor!
# -----------------------------------------------------------------------------
VITE_APP_NAME="OficioLink"
VITE_APP_VERSION="2.0.0"
VITE_APP_ENV="development"
VITE_DEFAULT_COUNTRY="MX"
VITE_DEFAULT_CURRENCY="MXN"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_PUBLIC_KEY="your-public-anon-key-restricted-by-rls"
VITE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# -----------------------------------------------------------------------------
# 2. VARIABLES PRIVADAS EXCLUSIVAS DE SERVIDOR / BACKEND PROXY (SIN prefijo VITE_)
# Jamás se empaquetan ni exponen en el navegador
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY="NEVER_EXPOSE_IN_FRONTEND_SERVER_ONLY"
PII_AES256_MASTER_KEY="replace_with_32_byte_hex_master_key_in_server_vault"
JWT_SIGNING_SECRET="replace_with_strong_256_bit_server_jwt_secret"
TURNSTILE_SECRET_KEY="replace_with_cloudflare_turnstile_private_secret"
