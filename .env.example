# =============================================================================
# OficioLink — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a `.env` para desarrollo local: cp .env.example .env
# =============================================================================

# Metadatos de la Aplicación
VITE_APP_NAME="OficioLink"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"

# Configuración Regional y Moneda (Contexto México)
VITE_DEFAULT_COUNTRY="MX"
VITE_DEFAULT_CURRENCY="MXN"
VITE_DEFAULT_LOCALE="es-MX"

# Endpoints de API y Servicios de Verificación (Mock / Producción)
VITE_API_BASE_URL="http://localhost:5173/api/v1"
VITE_ENABLE_BIOMETRIC_SIMULATOR="true"
VITE_ENABLE_OCR_INE_VALIDATION="true"
